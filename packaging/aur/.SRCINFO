pkgbase = silere-shell-git
	pkgdesc = Quickshell desktop shell for Hyprland and niri: bar, notifications, OSD and tray in one process
	pkgver = 1.5.0.r0.g03d2653
	pkgrel = 1
	url = https://github.com/s3rven/silere-shell
	install = silere-shell-git.install
	arch = any
	license = MIT
	makedepends = git
	depends = quickshell>=0.3.1
	optdepends = hyprland: compositor support
	optdepends = niri: compositor support
	optdepends = ttf-jetbrains-mono-nerd: the default bar font and every glyph in the UI
	optdepends = fontconfig: detect installed text and icon fonts
	optdepends = systemd: session locking, optional shell supervision and update timer
	optdepends = matugen: colours generated from your wallpaper
	optdepends = pipewire: volume and the output picker
	optdepends = wireplumber: volume and the output picker
	optdepends = upower: battery
	optdepends = brightnessctl: brightness
	optdepends = ddcutil: optional external monitor brightness
	optdepends = cava: media visualizer
	optdepends = hyprsunset: night light on Hyprland
	optdepends = wlsunset: night light on niri
	optdepends = power-profiles-daemon: power profiles
	optdepends = hyprlock: lock action on Hyprland
	optdepends = swaylock: lock action
	optdepends = gtklock: lock action
	optdepends = libnotify: battery, temperature and update notifications
	optdepends = networkmanager: network widget and Wi-Fi list
	optdepends = nm-connection-editor: advanced Wi-Fi and VPN settings
	optdepends = xdg-terminal-exec: open terminal-based network settings
	optdepends = bluez: Bluetooth widget and device list
	optdepends = blueman: Bluetooth PIN and passkey pairing
	optdepends = pwvucontrol: sound settings from the volume widget
	optdepends = pavucontrol: sound settings from the volume widget
	optdepends = inotify-tools: screenshot-file watcher for underline feedback
	optdepends = pacman-contrib: package update badge
	optdepends = fakeroot: package update badge (checkupdates needs it)
	optdepends = paru: AUR update count
	optdepends = yay: AUR update count
	optdepends = curl: cover art from the web
	optdepends = xdg-utils: open a network sign-in page
	provides = silere-shell
	conflicts = silere-shell
	source = silere-shell::git+https://github.com/s3rven/silere-shell.git
	sha256sums = SKIP

pkgname = silere-shell-git
