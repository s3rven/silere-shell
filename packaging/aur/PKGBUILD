# Maintainer: s3rven <s3rven@users.noreply.github.com>

pkgname=silere-shell-git
_pkgname=silere-shell
pkgver=1.3.0.r0.geeca96d
pkgrel=1
pkgdesc="Quickshell desktop shell for Hyprland and niri: bar, notifications, OSD and tray in one process"
arch=('any')
url="https://github.com/s3rven/silere-shell"
license=('MIT')
depends=('quickshell>=0.3.1')
makedepends=('git')
optdepends=(
    'hyprland: compositor support'
    'niri: compositor support'
    'ttf-jetbrains-mono-nerd: the default bar font and every glyph in the UI'
    'fontconfig: detect installed Nerd Fonts and offer them in the font picker'
    'systemd: loginctl lock action and optional user update timer'
    'matugen: colours generated from your wallpaper'
    'pipewire: volume and the output picker'
    'wireplumber: volume and the output picker'
    'upower: battery'
    'brightnessctl: brightness'
    'cava: media visualizer'
    'hyprsunset: night light on Hyprland'
    'wlsunset: night light on niri'
    'power-profiles-daemon: power profiles'
    'hyprlock: lock action on Hyprland'
    'swaylock: lock action'
    'gtklock: lock action'
    'libnotify: battery, temperature and update notifications'
    'networkmanager: network widget and Wi-Fi list'
    'bluez: Bluetooth widget and device list'
    'pwvucontrol: sound settings from the volume widget'
    'pavucontrol: sound settings from the volume widget'
    'inotify-tools: screenshot-file watcher for underline feedback'
    'pacman-contrib: package update badge'
    'fakeroot: package update badge (checkupdates needs it)'
    'paru: AUR update count'
    'yay: AUR update count'
    'curl: cover art from the web'
    'xdg-utils: open a network sign-in page'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
install="$pkgname.install"
source=("$_pkgname::git+https://github.com/s3rven/silere-shell.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    git describe --long --tags --abbrev=7 --match 'v[0-9]*' 2>/dev/null \
        | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$srcdir/$_pkgname"

    local dest="$pkgdir/usr/share/$_pkgname"
    install -dm755 "$dest"
    cp -a --no-preserve=ownership \
        shell.qml release.json config modules services "$dest/"
    printf '%s\n' "$pkgver" > "$dest/package-version"

    # only the scripts the shell itself runs; tests, probes and linters are
    # developer tooling, and uninstall.sh would tear down a pacman-owned install
    install -dm755 "$dest/scripts"
    cp -a --no-preserve=ownership \
        scripts/install.sh scripts/update.sh scripts/repair.sh scripts/doctor.sh \
        scripts/silere \
        scripts/silere-update.service scripts/silere-update.timer \
        scripts/lib "$dest/scripts/"

    # the shell loads no asset at runtime; only the matugen template is used, and
    # post_install tells the user to copy it from here
    install -Dm644 assets/matugen-theme.json "$dest/assets/matugen-theme.json"

    # the checkout ships a .git-less copy: the in-shell updater detects that and
    # steps aside so packaged installs update through pacman instead
    find "$dest" -type d -exec chmod 755 {} +
    find "$dest" -type f -exec chmod 644 {} +
    find "$dest/scripts" -type f -name '*.sh' -exec chmod 755 {} +
    chmod 755 "$dest/scripts/silere"

    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/share/$_pkgname/scripts/silere" "$pkgdir/usr/bin/$_pkgname"
    ln -s "/usr/share/$_pkgname/scripts/silere" "$pkgdir/usr/bin/silere"
    install -Dm644 scripts/completions/silere.fish \
        "$pkgdir/usr/share/fish/vendor_completions.d/silere.fish"
    install -Dm644 scripts/completions/silere.bash \
        "$pkgdir/usr/share/bash-completion/completions/silere"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
    local docdir="$pkgdir/usr/share/doc/$_pkgname"
    install -Dm644 -t "$docdir" README.md CONTRIBUTING.md CHANGELOG.md
    cp -a docs "$docdir/"
    install -Dm644 -t "$docdir/assets" \
        assets/banner.svg assets/banner-light.svg assets/shot-*.webp
}
