# generated by silere-shell
# silere update keeps this file current; put changes of your own in a drop-in: systemctl --user edit silere-shell
[Unit]
Description=Silere desktop shell
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStart=@SILERE_LAUNCHER@ run
Restart=on-failure
# quickshell exits 255 only when it has no compositor: at logout, or once Hyprland or niri is gone. A crash is a
# signal and restarts; a restart without a compositor cannot help, and a logout is not a failure
RestartPreventExitStatus=255
SuccessExitStatus=255
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
