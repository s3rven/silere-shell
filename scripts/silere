#!/usr/bin/env bash
set -euo pipefail
original_lc_all_set="${LC_ALL+x}"
original_lc_all="${LC_ALL-}"
export LC_ALL=C

source_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[ -n "$source_path" ] || source_path="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$source_path")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$ROOT/scripts/lib/xdg.sh"
source "$ROOT/scripts/lib/unit.sh"
source "$ROOT/scripts/lib/completions.sh"
source "$ROOT/scripts/lib/ui.sh"

usage() {
    # bold the command column when colors are on; the text itself stays plain. Callers
    # redirect this to stderr, so test the descriptor it is writing to now
    local b="" r=""
    ! _silere_color_fd 1 || { b=$'\033[1m'; r=$'\033[0m'; }
    _usage_text | awk -v b="$b" -v r="$r" '
        /^Usage:/ { print b $0 r; next }
        /^  [^ ]/ { printf "  %s%s%s%s\n", b, substr($0, 3, 23), r, substr($0, 26); next }
        { print }'
}

_usage_text() {
    cat <<'EOF'
Usage: silere <command> [options]

  run [--startup]        Start Silere once; --startup waits for the compositor
  run --supervised       Start through the optional user service
  service install        Install the optional service; --dry-run previews it
  service status         Show the optional service state
  service remove         Stop and remove the owned service
  restart                Stop the running shell and start it again
  use [checkout]         Make this checkout (or the given one) the one that runs
  status                 Show installation and updater state
  log [--follow]         Print the running shell's log
  doctor                 Run read-only installation diagnostics
  ipc <target> <fn> ...  Call the running shell over IPC; alone, it lists the calls
  link                   Put silere on PATH, in ~/.local/bin, with shell completions
  update                 Check for a signed Silere release
  update --apply         Install the confirmed signed release
  update --rollback      Restore the revision an update replaced
  repair                 Preview local checkout changes
  repair --apply [--yes] Save local changes and restore shipped files
  repair --undo [--yes]  Restore the latest repair stash
  version                Print the installed Silere version
  -V, --version          Print the installed Silere version
  uninstall              Remove integrations created by the installer
  help                   Show this message
EOF
}

die() {
    printf '%ssilere:%s %s\n' "$ERED" "$ER" "$*" >&2
    exit 1
}

run_shell() {
    local startup=0 supervised=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --startup) startup=1; shift ;;
            --supervised) supervised=1; shift ;;
            *) break ;;
        esac
    done
    # ahead of the checks below: at login, nobody reads what they print
    [ "$startup" -eq 0 ] || ( report_failed_start </dev/null >/dev/null 2>&1 & )
    [ -f "$ROOT/shell.qml" ] || die "shell.qml is missing from $ROOT"
    command -v qs >/dev/null 2>&1 || die "Quickshell is not installed"

    # at compositor boot the wayland endpoints can lag the autostart event
    [ "$startup" -eq 0 ] || sleep 1

    if [ "$supervised" -eq 1 ]; then
        [ "$#" -eq 0 ] || die "--supervised does not accept Quickshell arguments"
        if ! systemctl --user is-active --quiet silere-shell.service && pid="$(running_pid)"; then
            die "stop the running shell (pid $pid) before switching to supervised startup"
        fi
        restore_locale
        exec bash "$ROOT/scripts/service.sh" start
    fi

    if [ "$startup" -eq 0 ] && pid="$(running_pid)"; then
        printf 'Silere is already running (pid %s); silere restart starts it again\n' "$pid"
        exit 0
    fi
    if [ "$startup" -eq 0 ] && other="$(other_shell)"; then
        die "Silere is already running from $(dirname "$other"); silere use switches to this checkout"
    fi

    restore_locale
    # Qt discards the cached image after its first texture upload with this set.
    # A second window (or a rebuilt tray) can then receive an empty texture.
    unset QSG_TRANSIENT_IMAGES
    # an update rewrites qml files one by one, so a reload mid-update loads a mixed tree
    export SILERE_WATCH_FILES="${SILERE_WATCH_FILES-0}"
    # the detailed log keeps every debug line in the RAM-backed runtime dir, about 3 MB an hour; warnings still land
    # the flag is hidden, and an unknown flag stops qs from starting, so probe it first
    local detail=()
    qs --no-detailed-logs --version >/dev/null 2>&1 && detail=(--no-detailed-logs)
    # CachyOS ananicy rules send a process named qs to nice 10, and a bar is not a background job.
    # qs links to quickshell where both exist, so start it under its own name
    local shell_bin
    shell_bin="$(readlink -f -- "$(command -v qs)")" || shell_bin=qs
    exec "$shell_bin" --no-duplicate "${detail[@]}" -p "$ROOT/shell.qml" "$@"
}

# Silere is the notification daemon, so nothing else on the desktop can say it failed to start.
# One look once login has settled, then this exits; nothing stays behind watching the shell
report_failed_start() {
    local doctor="silere doctor" message
    sleep "${SILERE_STARTUP_GRACE:-20}"
    if running_pid >/dev/null || other_shell >/dev/null; then return 0; fi
    command -v silere >/dev/null 2>&1 || doctor="$ROOT/scripts/silere doctor"
    message="Silere did not start. Run $doctor in a terminal to see why."
    # Hyprland first: notify-send could wake another installed daemon, which then keeps Silere's place on the bus
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
        hyprctl notify 3 60000 0 "$message"
    elif command -v notify-send >/dev/null 2>&1; then
        timeout 5 notify-send --urgency=critical --app-name=silere-shell "Silere did not start" \
            "Run $doctor in a terminal to see why."
    fi
}

# LC_ALL=C is for this script's parsing; programs the shell launches get the user's locale
restore_locale() {
    if [ -n "$original_lc_all_set" ]; then
        export LC_ALL="$original_lc_all"
    else
        unset LC_ALL
    fi
}

# under LC_ALL=C, qs logs a locale warning straight to the journal, past any stderr redirect
user_qs() {
    (restore_locale; exec qs "$@")
}

running_pid() {
    local pid=""
    command -v qs >/dev/null 2>&1 || return 1
    pid="$(user_qs list -p "$ROOT/shell.qml" 2>/dev/null \
        | sed -n 's/^  Process ID: \([0-9][0-9]*\)$/\1/p')" || true
    pid="${pid%%$'\n'*}"
    [ -n "$pid" ] || return 1
    printf '%s\n' "$pid"
}

# the shell on screen may run from another copy, such as an installed one beside a dev checkout;
# one other Silere is unambiguous, two are not
other_shell() {
    local paths p found=""
    paths="$(user_qs list --all --json 2>/dev/null \
        | sed -n 's/^ *"config_path": "\(.*\)",\{0,1\}$/\1/p')" || true
    while IFS= read -r p; do
        [ -n "$p" ] && [ "$p" != "$ROOT/shell.qml" ] && [ -x "$(dirname "$p")/scripts/silere" ] || continue
        [ -z "$found" ] || return 1
        found="$p"
    done <<< "$paths"
    [ -n "$found" ] || return 1
    printf '%s\n' "$found"
}

IPC_QML="$ROOT/shell.qml"
IPC_ERR=""
# one round trip on the happy path, which keybinds pay for: only a call that found no shell looks further
ipc_shell() {
    local out rc=0 other
    IPC_ERR="$(mktemp)"
    out="$(user_qs ipc -p "$IPC_QML" "$@" 2>"$IPC_ERR")" || rc=$?
    if [ "$rc" -ne 0 ] && grep -q '^No running instances' "$IPC_ERR" <(printf '%s\n' "$out"); then
        if ! other="$(other_shell)"; then
            rm -f "$IPC_ERR"
            unit_runs_shell \
                && die "Silere is not running; its last run is in journalctl --user -u silere-shell.service"
            die "Silere is not running; start it with silere run"
        fi
        printf '%ssilere:%s using the shell running from %s\n' "$EYELLOW" "$ER" "$(dirname "$other")" >&2
        IPC_QML="$other"
        rc=0; out="$(user_qs ipc -p "$IPC_QML" "$@" 2>"$IPC_ERR")" || rc=$?
    fi
    cat "$IPC_ERR" >&2; rm -f "$IPC_ERR"
    printf '%s' "$out"
    return "$rc"
}

unit_runs_shell() {
    command -v systemctl >/dev/null 2>&1 || return 1
    systemctl --user is-active --quiet silere-shell.service 2>/dev/null \
        || systemctl --user is-enabled --quiet silere-shell.service 2>/dev/null \
        || return 1
    _silere_unit_runs_checkout "$ROOT"
}

await_exit() {
    for _ in $(seq 50); do
        running_pid >/dev/null || return 0
        sleep 0.1
    done
    return 1
}

# prints the pid of an instance other than the one being replaced
await_shell() {
    local old="$1" pid
    for _ in $(seq 50); do
        if pid="$(running_pid)" && [ "$pid" != "$old" ]; then
            printf '%s\n' "$pid"
            return 0
        fi
        sleep 0.2
    done
    return 1
}

stop_stray_shell() {
    local pid="$1"
    [ -n "$pid" ] || return 0
    user_qs kill -p "$ROOT/shell.qml" >/dev/null 2>&1 || true
    await_exit || die "the running shell (pid $pid) did not stop"
}

restart_shell() {
    local old_pid pid qs_error
    [ -f "$ROOT/shell.qml" ] || die "shell.qml is missing from $ROOT"
    command -v qs >/dev/null 2>&1 || die "Quickshell is not installed"
    # after a Qt upgrade qs can fail to start while the running shell still works; stopping it would leave no UI
    qs_error="$(user_qs --version 2>&1 >/dev/null)" \
        || die "Quickshell cannot start, so the running shell was left alone: ${qs_error%%$'\n'*}"
    old_pid="$(running_pid)" || old_pid=""
    # restarting here would leave the other copy on screen and start a second bar beside it
    if [ -z "$old_pid" ] && ! unit_runs_shell && other="$(other_shell)"; then
        die "the shell on screen runs from $(dirname "$other"), not $ROOT; silere use switches to this checkout"
    fi
    if unit_runs_shell; then
        systemctl --user is-active --quiet silere-shell.service 2>/dev/null \
            || stop_stray_shell "$old_pid"
        # a crash loop leaves the unit refusing starts until this clears
        systemctl --user reset-failed silere-shell.service 2>/dev/null || true
        systemctl --user restart silere-shell.service \
            || die "systemd could not restart silere-shell.service"
        pid="$(await_shell "$old_pid")" \
            || die "the shell did not come back; see journalctl --user -u silere-shell.service"
    else
        [ -n "${WAYLAND_DISPLAY:-}" ] || die "run this from inside your Wayland session"
        stop_stray_shell "$old_pid"
        (restore_locale; exec bash "$ROOT/scripts/silere" run --daemonize) \
            </dev/null >/dev/null 2>&1 || true
        pid="$(await_shell "$old_pid")" || die "the shell did not start; run silere run to see why"
    fi
    if [ -n "$old_pid" ]; then
        printf '%sSilere restarted%s (pid %s)\n' "$GREEN" "$R" "$pid"
    else
        printf '%sSilere started%s (pid %s)\n' "$GREEN" "$R" "$pid"
    fi
}

# a drop-in, so a unit written by hand or by another installer is left as it is
use_checkout() {
    local target="$ROOT" dry=0 link_dir link_path current config_home dropin unit_root="" unit_known=0 other
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dry-run) dry=1 ;;
            -*) usage >&2; exit 2 ;;
            *) [ "$target" = "$ROOT" ] || { usage >&2; exit 2; }
                target="$(cd -- "$1" 2>/dev/null && pwd -P)" || die "$1 is not a directory" ;;
        esac
        shift
    done
    [ -f "$target/shell.qml" ] && [ -x "$target/scripts/silere" ] || die "$target is not a Silere checkout"
    case "$target" in *$'\n'*|*$'\r'*) die "the checkout path cannot contain a newline" ;; esac
    ! is_packaged || die "the $(package_manager) package decides which copy runs"
    [ "${HOME#/}" != "$HOME" ] || die "HOME must be absolute"
    config_home="$(_silere_xdg_home "${XDG_CONFIG_HOME:-}" .config)" || die "HOME must be absolute"
    dropin="$config_home/systemd/user/silere-shell.service.d/silere-use.conf"
    link_dir="$HOME/.local/bin"
    link_path="$link_dir/silere"

    current="$(readlink -f -- "$link_path" 2>/dev/null || true)"
    if [ "$current" = "$target/scripts/silere" ]; then
        printf 'silere on PATH: already %s\n' "$target"
    elif { [ -L "$link_path" ] && [ "${current%/scripts/silere}" != "$current" ] \
            && [ -f "${current%/scripts/silere}/shell.qml" ]; } \
            || { [ ! -e "$link_path" ] && [ ! -L "$link_path" ]; }; then
        if [ "$dry" -eq 1 ]; then
            printf 'silere on PATH: would link %s -> %s\n' "$link_path" "$target/scripts/silere"
        else
            (umask 077 && mkdir -p -- "$link_dir") || die "could not create $link_dir"
            ln -sfn -- "$target/scripts/silere" "$link_path" || die "could not link $link_path"
            printf 'silere on PATH: %s\n' "$target"
        fi
    else
        printf '%snote:%s %s is not a link to a Silere checkout; left it alone\n' "$YELLOW" "$R" "$link_path"
    fi

    if command -v systemctl >/dev/null 2>&1 \
            && [ "$(systemctl --user show silere-shell.service -p LoadState --value 2>/dev/null)" = loaded ]; then
        unit_known=1
        if [ -e "$dropin" ] && ! grep -qx '# generated by silere use' "$dropin"; then
            die "$dropin was not written by silere use; edit it by hand"
        fi
        unit_root="$(_silere_unit_checkout)" || unit_root=""
    fi
    if [ "$unit_known" -eq 1 ] && [ "$unit_root" != "$target" ]; then
        if [ "$dry" -eq 1 ]; then
            printf 'service: would start %s (drop-in %s)\n' "$target" "$dropin"
        else
            # the unit's own command may already be the target; only then is no override needed
            if [ -e "$dropin" ]; then
                rm -f -- "$dropin"
                rmdir -- "${dropin%/*}" 2>/dev/null || true
                systemctl --user daemon-reload || die "systemd could not reload the user units"
                unit_root="$(_silere_unit_checkout)" || unit_root=""
            fi
            if [ "$unit_root" != "$target" ]; then
                mkdir -p -- "${dropin%/*}" || die "could not create ${dropin%/*}"
                { printf '%s\n' '# generated by silere use' '[Unit]' 'ConditionPathExists=' \
                    "ConditionPathExists=${target//%/%%}/shell.qml" '[Service]' 'ExecStart=' \
                    "ExecStart=$(_silere_unit_exec_quote "$target/scripts/silere") run" > "$dropin.tmp" \
                    && mv -- "$dropin.tmp" "$dropin"; } || die "could not write $dropin"
                systemctl --user daemon-reload || die "systemd could not reload the user units"
            fi
            printf 'service: starts %s\n' "$target"
        fi
    elif [ "$unit_known" -eq 1 ]; then
        printf 'service: already starts %s\n' "$target"
    fi
    # the service is covered above; a compositor startup line is the user's file and names one path
    if [ "$unit_known" -eq 0 ] || ! systemctl --user is-enabled --quiet silere-shell.service 2>/dev/null; then
        printf '%snote:%s a startup line in your compositor config keeps its own path; point it at %s/scripts/silere\n' \
            "$YELLOW" "$R" "$target"
    fi

    [ "$dry" -eq 0 ] || return 0
    # systemd replaces the unit's own shell; an unsupervised one from another copy has to stop first
    if [ "$unit_known" -eq 0 ] || ! systemctl --user is-active --quiet silere-shell.service 2>/dev/null; then
        local paths p
        paths="$(user_qs list --all --json 2>/dev/null \
            | sed -n 's/^ *"config_path": "\(.*\)",\{0,1\}$/\1/p')" || true
        while IFS= read -r p; do
            [ -n "$p" ] && [ "$p" != "$target/shell.qml" ] && [ -x "$(dirname "$p")/scripts/silere" ] || continue
            user_qs kill -p "$p" >/dev/null 2>&1 || true
            for _ in $(seq 50); do
                [[ "$(user_qs list -p "$p" 2>/dev/null)" == *"Process ID"* ]] || break
                sleep 0.1
            done
        done <<< "$paths"
    fi
    restore_locale
    exec bash "$target/scripts/silere" restart
}

link_completions() {
    local src dest
    while IFS=$'\t' read -r src dest; do
        if [ -L "$dest" ] && [ "$(readlink -f -- "$dest" 2>/dev/null || true)" = "$src" ]; then
            continue
        elif [ -e "$dest" ] || [ -L "$dest" ]; then
            printf '%snote:%s %s already exists; left it alone\n' "$YELLOW" "$R" "$dest"
        elif (umask 077 && mkdir -p -- "${dest%/*}") && ln -s -- "$src" "$dest"; then
            printf 'linked %s\n' "$dest"
        else
            printf '%snote:%s could not link %s\n' "$EYELLOW" "$ER" "$dest" >&2
        fi
    done < <(_silere_completion_links "$ROOT")
}

package_manager() {
    if command -v pacman >/dev/null 2>&1; then printf 'pacman'
    elif command -v dnf >/dev/null 2>&1; then printf 'dnf'
    elif command -v apt >/dev/null 2>&1; then printf 'apt'
    elif command -v zypper >/dev/null 2>&1; then printf 'zypper'
    elif command -v xbps-install >/dev/null 2>&1; then printf 'xbps'
    else printf 'the system package manager'
    fi
}

version_info() {
    bash "$ROOT/scripts/update.sh" --version
}

is_packaged() {
    grep -q '^packaged=1$' <<<"$(version_info 2>/dev/null)"
}

print_update_status() {
    local cache_home cache_dir flag count target error
    cache_home="$(_silere_xdg_home "${XDG_CACHE_HOME:-}" .cache)" \
        || die "HOME must be absolute"
    cache_dir="$cache_home/silere-shell"
    flag="$cache_dir/update-pending"
    count="$(sed -n '1p' "$flag" 2>/dev/null || true)"
    target="$(sed -n '2p' "$flag" 2>/dev/null || true)"
    if [[ "$count" =~ ^[0-9]{1,6}$ ]] \
            && [[ "$target" =~ ^target\ ([0-9a-f]{40}|[0-9a-f]{64})\ (v[0-9]+\.[0-9]+\.[0-9]+)\ verified$ ]]; then
        printf 'Update: %s%s ready%s (%s commit%s, signature verified)\n' "$GREEN" \
            "${BASH_REMATCH[2]}" "$R" "$count" "$([ "$count" = 1 ] || printf s)"
        return
    fi
    error="$(sed -n '2p' "$cache_dir/update-error" 2>/dev/null \
        | LC_ALL=C tr -d '\001-\037\177' | cut -c 1-512 || true)"
    if [ -n "$error" ]; then
        printf 'Update: %slast check failed%s — %s\n' "$RED" "$R" "$error"
    elif [ -s "$cache_dir/update-checked" ]; then
        printf 'Update: no pending release from the last check\n'
    else
        printf 'Update: not checked yet\n'
    fi
}

print_transaction_status() {
    local out phase tag
    if ! out="$(bash "$ROOT/scripts/update.sh" --transaction-status 2>/dev/null)"; then
        if grep -q '^pending=1$' <<<"$out"; then
            printf 'Update transaction: %srecovery state is damaged%s; run silere doctor\n' "$RED" "$R"
        fi
        return 0
    fi
    if grep -q '^quarantined=1$' <<<"$out"; then
        printf 'Update transaction: %sdamaged recovery state was preserved%s; run silere doctor\n' "$YELLOW" "$R"
        return 0
    fi
    grep -q '^pending=1$' <<<"$out" || return 0
    phase="$(printf '%s\n' "$out" | sed -n 's/^phase=//p')"
    tag="$(printf '%s\n' "$out" | sed -n 's/^tag=//p')"
    if [ "$phase" = validated ]; then
        printf 'Update transaction: %s validated; cleanup/restart was interrupted\n' "${tag:-release}"
    else
        printf 'Update transaction: %s interrupted during %s; the next update run will recover it\n' \
            "${tag:-release}" "${phase:-apply}"
    fi
}

human_version() {
    local out packaged version tag sha ahead
    out="$(version_info)" || return 1
    packaged="$(printf '%s\n' "$out" | sed -n 's/^packaged=//p')"
    version="$(printf '%s\n' "$out" | sed -n 's/^version=//p')"
    if [ "$packaged" = 1 ]; then
        printf '%sSilere Shell %s%s (managed by %s)\n' "$BOLD" "${version:-package build}" "$R" "$(package_manager)"
        return 0
    fi
    tag="$(printf '%s\n' "$out" | sed -n 's/^tag=//p')"
    sha="$(printf '%s\n' "$out" | sed -n 's/^sha=//p')"
    ahead="$(printf '%s\n' "$out" | sed -n 's/^ahead=//p')"
    printf '%sSilere Shell %s%s%s%s\n' "$BOLD" "${tag:-#$sha}" "$R" \
        "$([ "${ahead:-0}" -gt 0 ] 2>/dev/null && printf ' +%s' "$ahead")" \
        "$([ -n "$sha" ] && printf ' (#%s)' "$sha")"
}

# The packaged desktop entry is a symlink to this same executable. Its historical
# arguments belong to Quickshell, while `silere` arguments are maintenance commands.
if [ "${0##*/}" = silere-shell ]; then
    set -- run "$@"
fi

command_name="${1:-help}"
shift || true

case "$command_name" in
    help|-h|--help)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        usage
        ;;
    version|-V|--version)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        human_version
        ;;
    run)
        run_shell "$@"
        ;;
    service)
        exec bash "$ROOT/scripts/service.sh" "$@"
        ;;
    restart)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        restart_shell
        ;;
    use)
        use_checkout "$@"
        ;;
    log)
        follow=()
        case "${1:-}" in
            "") [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
            -f|--follow) [ "$#" -eq 1 ] || { usage >&2; exit 2; }
                follow=(--follow) ;;
            *) usage >&2; exit 2 ;;
        esac
        command -v qs >/dev/null 2>&1 || die "Quickshell is not installed"
        log_qml="$ROOT/shell.qml"
        if ! running_pid >/dev/null; then
            if other="$(other_shell)"; then
                printf '%ssilere:%s using the shell running from %s\n' "$EYELLOW" "$ER" "$(dirname "$other")" >&2
                log_qml="$other"
            else
                unit_runs_shell \
                    && die "Silere is not running; its last run is in journalctl --user -u silere-shell.service"
                die "Silere is not running"
            fi
        fi
        color=()
        [ -t 1 ] || color=(--no-color)
        restore_locale
        exec qs log "${color[@]}" -p "$log_qml" "${follow[@]}"
        ;;
    status)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        info="$(version_info)" || die "could not read updater state"
        human_version
        if shell_pid="$(running_pid)"; then
            printf 'Shell: %srunning%s (pid %s)\n' "$GREEN" "$R" "$shell_pid"
        elif other="$(other_shell)"; then
            printf 'Shell: %srunning from another copy%s, %s; silere use switches to this one\n' \
                "$YELLOW" "$R" "$(dirname "$other")"
        else
            printf 'Shell: %snot running%s\n' "$RED" "$R"
        fi
        printf 'Location: %s\n' "$ROOT"
        if command -v systemctl >/dev/null 2>&1 && unit_root="$(_silere_unit_checkout)"; then
            if [ "$unit_root" = "$ROOT" ]; then
                printf 'Service: silere-shell.service starts this checkout\n'
            else
                printf 'Service: silere-shell.service starts %s%s%s\n' "$YELLOW" "$unit_root" "$R"
            fi
        fi
        if grep -q '^packaged=1$' <<<"$info"; then
            printf 'Updates: managed by %s; Silere self-update is disabled\n' "$(package_manager)"
        else
            branch="$(printf '%s\n' "$info" | sed -n 's/^branch=//p')"
            dirty="$(printf '%s\n' "$info" | sed -n 's/^dirty=//p')"
            mode="$(printf '%s\n' "$info" | sed -n 's/^mode=//p')"
            if [ "$mode" = development ]; then
                printf 'Installation: Development checkout; updates are managed with Git\n'
            else
                printf 'Installation: Managed release; signed self-update is enabled\n'
            fi
            printf 'Checkout: %s%s\n' "${branch:-unknown branch}" \
                "$([ "$dirty" = 1 ] && printf ' (local changes)')"
            print_transaction_status
            print_update_status
            timer="$(bash "$ROOT/scripts/update.sh" --timer-status 2>/dev/null || true)"
            if grep -q '^enabled=1$' <<<"$timer"; then
                printf 'Update timer: enabled\n'
            else
                printf 'Update timer: disabled or unavailable\n'
            fi
        fi
        ;;
    doctor)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        exec bash "$ROOT/scripts/doctor.sh"
        ;;
    ipc)
        command -v qs >/dev/null 2>&1 || die "qs (Quickshell) is not installed"
        # under this script's LC_ALL=C, Qt prints a locale warning ahead of every answer
        restore_locale
        if [ "$#" -eq 0 ] || { [ "$1" = show ] && [ "$#" -eq 1 ]; }; then
            listing="$(ipc_shell show)" || exit $?
            printf '%s\n' "$listing"
            exit 0
        fi
        if [ "$#" -eq 1 ]; then
            # a target alone lists its calls rather than Quickshell's "Function required"
            listing="$(ipc_shell show)" || exit $?
            calls="$(printf '%s\n' "$listing" | awk -v t="$1" '/^target / { on = ($2 == t) } on')"
            [ -n "$calls" ] || die "no IPC target named $1; silere ipc lists them"
            printf '%s\n' "$calls"
            exit 0
        fi
        # a refused call still exits 0 with its reason on stdout: the shell's own "error:" line, or
        # Quickshell's for a target, function or argument it cannot match; scripts need a failure
        rc=0; out="$(ipc_shell call "$@")" || rc=$?
        case "$out" in
            error:*|"Target not found."|"Function not found."|"Too few arguments provided"*\
                |"Too many arguments provided"*|"Unable to parse argument"*)
                [ "$rc" -ne 0 ] || rc=1 ;;
        esac
        if [ "$rc" -ne 0 ]; then
            [ -z "$out" ] || printf '%s\n' "$out" >&2
            exit "$rc"
        fi
        [ -z "$out" ] || printf '%s\n' "$out"
        ;;
    update)
        if is_packaged; then
            die "updates are managed by $(package_manager); Silere will not modify package-owned files"
        fi
        case "${1:-}" in
            "") [ "$#" -eq 0 ] || { usage >&2; exit 2; }
                # the check itself stays silent for the timer and the menu; say what it found here
                rc=0; bash "$ROOT/scripts/update.sh" || rc=$?
                human_version || true
                print_update_status
                [ ! -s "$(_silere_xdg_home "${XDG_CACHE_HOME:-}" .cache)/silere-shell/update-pending" ] \
                    || printf 'silere update --apply installs it\n'
                exit "$rc" ;;
            --apply) [ "$#" -eq 1 ] || { usage >&2; exit 2; }
                exec bash "$ROOT/scripts/update.sh" --apply ;;
            --rollback) [ "$#" -eq 1 ] || { usage >&2; exit 2; }
                exec bash "$ROOT/scripts/update.sh" --rollback ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    repair)
        if is_packaged; then
            die "this installation is managed by $(package_manager); repair its package there"
        fi
        [ -f "$ROOT/scripts/repair.sh" ] || die "this installation is managed by $(package_manager); repair it there"
        exec bash "$ROOT/scripts/repair.sh" "$@"
        ;;
    link)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        [ "${HOME#/}" != "$HOME" ] || die "HOME must be absolute"
        if is_packaged; then
            die "the $(package_manager) package already puts silere on PATH"
        fi
        link_dir="$HOME/.local/bin"
        link_path="$link_dir/silere"
        link_target="$ROOT/scripts/silere"
        if [ -L "$link_path" ] \
                && [ "$(readlink -f -- "$link_path" 2>/dev/null || true)" = "$link_target" ]; then
            printf 'silere is already linked at %s\n' "$link_path"
        elif [ -e "$link_path" ] || [ -L "$link_path" ]; then
            die "$link_path already exists and points elsewhere; remove it first"
        else
            (umask 077 && mkdir -p -- "$link_dir") || die "could not create $link_dir"
            ln -s -- "$link_target" "$link_path" || die "could not create $link_path"
            printf 'linked %s -> %s\n' "$link_path" "$link_target"
        fi
        link_completions
        case ":$PATH:" in
            *":$link_dir:"*) ;;
            *) printf '%snote:%s %s is not on your PATH; add it in your shell config\n' "$YELLOW" "$R" "$link_dir" ;;
        esac
        ;;
    uninstall)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        if is_packaged; then
            die "this installation is managed by $(package_manager); remove its package there"
        fi
        [ -f "$ROOT/scripts/uninstall.sh" ] \
            || die "this installation is managed by $(package_manager); remove its package there"
        exec bash "$ROOT/scripts/uninstall.sh"
        ;;
    *)
        printf '%ssilere:%s unknown command: %s\n' "$ERED" "$ER" "$command_name" >&2
        # within two edits of a real command is a typo, not a guess
        near="$(printf '%s\n' run restart use status log doctor ipc link update repair version uninstall help \
            | awk -v w="$command_name" '
                function dist(a, b,   i, j, m, n, d, c) {
                    m = length(a); n = length(b)
                    for (i = 0; i <= m; i++) d[i, 0] = i
                    for (j = 0; j <= n; j++) d[0, j] = j
                    for (i = 1; i <= m; i++) for (j = 1; j <= n; j++) {
                        c = substr(a, i, 1) != substr(b, j, 1)
                        d[i, j] = d[i-1, j] + 1
                        if (d[i, j-1] + 1 < d[i, j]) d[i, j] = d[i, j-1] + 1
                        if (d[i-1, j-1] + c < d[i, j]) d[i, j] = d[i-1, j-1] + c
                        if (i > 1 && j > 1 && substr(a, i, 1) == substr(b, j-1, 1) && substr(a, i-1, 1) == substr(b, j, 1) \
                            && d[i-2, j-2] + 1 < d[i, j]) d[i, j] = d[i-2, j-2] + 1
                    }
                    return d[m, n]
                }
                { x = dist(w, $0); if (best == "" || x < bestd) { best = $0; bestd = x } }
                END { if (best != "" && bestd <= 2) print best }')"
        if [ -n "$near" ]; then
            printf 'Did you mean: silere %s\n' "$near" >&2
        else
            usage >&2
        fi
        exit 2
        ;;
esac
